# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000

# Database: either DATABASE_URL (Render/Railway give you this) ...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kachipapa
# ... or individual settings:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=kachipapa
DB_SSL=false

# Long random string. Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Needed (as the X-Setup-Key header) to create the first admin account.
ADMIN_SETUP_KEY=change-me

# Comma-separated list of web origins allowed to call the API.
# Leave empty in development to allow all.
CORS_ORIGINS=

# Product image uploads (https://cloudinary.com, free tier is enough).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
